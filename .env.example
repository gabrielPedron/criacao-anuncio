# Credenciais do app de desenvolvedor do Mercado Livre
# Copie para .env e preencha. O .env esta no .gitignore e nunca vai pro chat.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://httpbin.org/get
ML_SITE=MLB

# --- Geração de mídia (Fase 3) ---
# Vídeo é feito à mão, fora do pipeline — não há chave do Google a preencher.
# OpenAI (imagem). platform.openai.com → API keys. NAO e a assinatura do ChatGPT.
OPENAI_API_KEY=

# --- Chrome do projeto (opcional: ml:busca, ml:sugestoes, ml:pagina) ---
# Sem estas linhas vale o padrão. Tire o # só da linha que quiser mudar.
# Teto de páginas do ML por dia, somando todos os comandos (padrão 80; um produto usa ~15).
# ML_CHROME_LIMITE_DIA=80
# Caminho do Chrome, só se o npm run verificar não achar sozinho. Exemplo no Windows:
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Porta de controle do Chrome do projeto (padrão 9334). Mude só se outro programa usar essa porta.
# ML_CHROME_PORTA=9334
